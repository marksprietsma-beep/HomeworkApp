# Local PostgreSQL connection used by Prisma.
# Copy this file to .env before running Prisma commands locally.
DATABASE_URL="postgresql://homework:homework@localhost:5432/homework_app?schema=public"

# Optional: override where locally uploaded assignment question images are stored.
# Defaults to ./data/uploads when unset. Use an absolute mounted data path on a server.
# LOCAL_MEDIA_ROOT=/absolute/path/to/homework-app/uploads

# Server-only SMTP submission. Automatic delivery stays off until controlled rollout.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.school.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=clarion-mailbox@school.example
SMTP_PASSWORD=replace-in-local-or-production-secret-file
MAIL_FROM_NAME="Harrow Haikou Clarion"
MAIL_FROM_ADDRESS=clarion-mailbox@school.example
APP_BASE_URL=https://clarion.school.example
