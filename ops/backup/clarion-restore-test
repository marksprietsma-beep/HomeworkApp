#!/bin/bash
set -Eeuo pipefail
umask 077

readonly BACKUP_ROOT="${CLARION_BACKUP_ROOT:-/var/backups/clarion}"
readonly PGPASSFILE="${PGPASSFILE:-/etc/clarion/backup.pgpass}"
readonly UPLOADS_ROOT="${CLARION_UPLOADS_ROOT:-/var/lib/clarion/uploads}"
# Debian installs runuser under /usr/sbin, which is not guaranteed to be in sudo's PATH.
readonly RUNUSER="/usr/sbin/runuser"
export PGHOST="${PGHOST:-127.0.0.1}" PGPORT="${PGPORT:-5432}" PGUSER="${PGUSER:-clarion}" PGPASSFILE
backup="${1:-}"
if [[ -z "$backup" ]]; then
  backup="$(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -name 'clarion-*' -printf '%f\n' | LC_ALL=C sort -r | head -1)"
fi
[[ "$backup" =~ ^clarion-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}[+-][0-9]{4}$ ]] || {
  echo "Specify a valid Clarion backup-set name (not a path)" >&2; exit 1;
}
readonly SET_PATH="$BACKUP_ROOT/$backup"
[[ -s "$SET_PATH/database.dump" && -s "$SET_PATH/uploads.tar.gz" ]] || {
  echo "Backup set is missing or incomplete: $backup" >&2; exit 1;
}
[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "Run restore verification as root" >&2; exit 1; }
[[ -r "$PGPASSFILE" ]] || { echo "PostgreSQL credential file is unreadable" >&2; exit 1; }
[[ -x "$RUNUSER" ]] || { echo "Required Debian utility is missing: $RUNUSER" >&2; exit 1; }

test_database="clarion_restore_test_$$"
extract_dir="$(mktemp -d /tmp/clarion-restore-test.XXXXXX)"
cleanup() {
  env -u PGHOST -u PGPORT -u PGUSER -u PGPASSFILE "$RUNUSER" -u postgres -- \
    dropdb --if-exists -- "$test_database" >/dev/null 2>&1 || true
  rm -rf --one-file-system -- "$extract_dir"
}
trap cleanup EXIT

pg_restore --list "$SET_PATH/database.dump" >/dev/null
tar --list --gzip --file="$SET_PATH/uploads.tar.gz" >/dev/null
env -u PGHOST -u PGPORT -u PGUSER -u PGPASSFILE "$RUNUSER" -u postgres -- \
  createdb --owner=clarion -- "$test_database"
pg_restore --exit-on-error --no-owner --no-privileges --dbname="$test_database" "$SET_PATH/database.dump"

for table in User Class HomeworkAssignment; do
  count="$(env -u PGHOST -u PGPORT -u PGUSER -u PGPASSFILE "$RUNUSER" -u postgres -- \
    psql --dbname="$test_database" --tuples-only --no-align \
    --command="SELECT count(*) FROM \"$table\";")"
  [[ "$count" =~ ^[0-9]+$ ]] || { echo "Could not verify table $table" >&2; exit 1; }
  echo "Verified table $table ($count rows)"
done
session_exists="$(env -u PGHOST -u PGPORT -u PGUSER -u PGPASSFILE "$RUNUSER" -u postgres -- \
  psql --dbname="$test_database" --tuples-only --no-align \
  --command="SELECT to_regclass('\"Session\"') IS NOT NULL;")"
[[ "$session_exists" == "t" ]] || { echo "Expected Session table is absent" >&2; exit 1; }
echo "Verified table Session"

tar --extract --gzip --file="$SET_PATH/uploads.tar.gz" --directory="$extract_dir"
archive_entries="$(tar --list --gzip --file="$SET_PATH/uploads.tar.gz" | LC_ALL=C sort)"
extracted_entries="$(tar --create --file=- --directory="$extract_dir" . | tar --list --file=- | LC_ALL=C sort)"
[[ "$archive_entries" == "$extracted_entries" ]] || { echo "Extracted upload paths do not match the archive" >&2; exit 1; }
echo "Successfully restored and verified $backup in disposable database $test_database"
