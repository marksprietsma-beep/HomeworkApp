[Unit]
Description=Process the Clarion email notification outbox
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=clarion
Group=clarion
WorkingDirectory=/opt/clarion
EnvironmentFile=/opt/clarion/.env.production
ExecStart=/usr/bin/npm run email:process
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/clarion/.next
